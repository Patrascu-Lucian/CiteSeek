# Copy to `.env.local` and fill in. This file is committed on purpose: it is the
# canonical list of every variable the app needs. Never put real secrets here.

# ---------------------------------------------------------------------------
# Milestone 0 — Slice 2 (database)
# ---------------------------------------------------------------------------
# Local: matches the docker-compose service.
# Production: the Neon *pooled* connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/citeseek"

# ---------------------------------------------------------------------------
# Milestone 0 — Slice 3 (auth)
# ---------------------------------------------------------------------------
# Session/JWT signing key for Auth.js. Generate 32 random bytes:
#   openssl rand -base64 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Do NOT use `pnpm dlx auth secret` — the `auth` package on npm is Better Auth's
# CLI, a different library, and it writes BETTER_AUTH_SECRET instead.
AUTH_SECRET=""

# GitHub OAuth App → Settings → Developer settings → OAuth Apps.
# Callback URL (local): http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ---------------------------------------------------------------------------
# Milestone 2 — cloud inference (Google Gemini, free tier)
# ---------------------------------------------------------------------------
# Create at https://aistudio.google.com/apikey
# Read automatically by @ai-sdk/google — this exact name matters, the provider
# looks it up by default rather than taking it as an argument.
# Serves both chat and embeddings, so there is no second AI provider key.
GOOGLE_GENERATIVE_AI_API_KEY=""
