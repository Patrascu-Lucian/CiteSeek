# Copy to `.env.local` and fill in. This file is committed on purpose: it is the
# canonical list of every variable the app needs. Never put real secrets here.

# ---------------------------------------------------------------------------
# Milestone 0 — Slice 2 (database)
# ---------------------------------------------------------------------------
# Used by the running app. Locally this matches the docker-compose service.
# In production use Neon's *pooled* string (hostname contains `-pooler`):
# serverless functions open many short-lived connections, which is what the
# pooler exists for.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/citeseek"

# Used by `pnpm db:migrate` and `pnpm db:seed` only. Neon's pooler is PgBouncer
# in transaction mode, which does not support schema migrations, so those need
# the *direct* string (no `-pooler` in the hostname).
# Leave unset locally and in CI — there is no pooler there, and both commands
# fall back to DATABASE_URL. Neon's Vercel integration sets this name for you.
DATABASE_URL_UNPOOLED=""

# ---------------------------------------------------------------------------
# Milestone 0 — Slice 3 (auth)
# ---------------------------------------------------------------------------
# Session/JWT signing key for Auth.js. Generate 32 random bytes:
#   openssl rand -base64 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Do NOT use `pnpm dlx auth secret` — the `auth` package on npm is Better Auth's
# CLI, a different library, and it writes BETTER_AUTH_SECRET instead.
AUTH_SECRET=""

# GitHub OAuth App → Settings → Developer settings → OAuth Apps.
# Callback URL (local): http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# ---------------------------------------------------------------------------
# Milestone 1 — embeddings (Google Gemini, free tier)
# ---------------------------------------------------------------------------
# Create at https://aistudio.google.com/apikey
# Read by @ai-sdk/google — this exact name matters, the provider looks it up by
# convention rather than taking it as an argument.
# Serves both chat and embeddings, so there is no second AI provider key.
GOOGLE_GENERATIVE_AI_API_KEY=""

# "google" (default) or "fake".
#
# "fake" swaps in a deterministic, hash-seeded embedder so the whole ingestion
# pipeline runs with no API key and no network — used by CI, the E2E suite, and
# offline development. The vectors are well-formed and stable but carry no
# meaning, so they prove the pipeline stores and orders correctly and prove
# nothing at all about retrieval quality.
#
# Leaving this unset means "google" on purpose: defaulting to the fake would let
# a misconfigured production deploy fill the database with meaningless vectors,
# an outage that looks like poor answer quality rather than a failure.
EMBEDDINGS_PROVIDER=""
