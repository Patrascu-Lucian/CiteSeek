# editors / tooling
.claude
.idea
.vscode
.DS_Store
Thumbs.db

# dependencies
/node_modules
/.pnp
.pnp.*

# next.js
/.next/
/out/
/build
next-env.d.ts
*.tsbuildinfo

# testing
/coverage
/test-results
/playwright-report
/blob-report
/playwright/.cache

# Playwright storage state holds live session cookies once auth exists (Slice 3).
/playwright/.auth/
/e2e/.auth/
storageState*.json

# User data. Milestone 1 accepts document uploads; nothing a user uploads belongs
# in version control, and a "just a test PDF" is exactly how real content leaks.
/uploads/
/storage/
/tmp/

# Database dumps and local database files. Note this must NOT match drizzle/*.sql,
# which are reviewable migrations and are committed on purpose.
*.dump
*.sqlite
*.sqlite3
/backups/

# env files: .env.example is committed on purpose as the canonical list of required vars
.env*
!.env.example

# vercel
.vercel

# misc
*.pem
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Generated by `pnpm onnx:copy` from the installed onnxruntime-web (74 MB).
public/onnx/

# Chromium profile for `pnpm eval:local-markers`, holding 884 MB of cached weights.
.local-model-profile/
eval/.local-markers-progress.json*
eval/.local-answers-progress-*.json*
