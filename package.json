{
  "name": "citeseek",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || echo 'warning: git hooks not enabled (no .git directory?)'",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx lib/db/seed.mts",
    "brand:card": "tsx scripts/build-social-card.mts",
    "brand:icons": "tsx scripts/build-brand-icons.mts",
    "demo:pdf": "tsx scripts/build-demo-pdf.mts",
    "demo:shots": "tsx scripts/build-readme-shots.mts",
    "db:check": "tsx lib/db/check-migrations.mts",
    "eval:retrieval": "tsx scripts/eval-retrieval.mts",
    "db:usage": "tsx scripts/usage-report.mts",
    "eval:local": "tsx scripts/eval-local-embedder.mts",
    "onnx:copy": "tsx scripts/copy-onnx-runtime.mts",
    "prebuild": "pnpm onnx:copy",
    "predev": "pnpm onnx:copy"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.44",
    "@ai-sdk/provider": "4.0.7",
    "@ai-sdk/react": "4.0.69",
    "@auth/drizzle-adapter": "1.11.3",
    "@huggingface/transformers": "^4.2.0",
    "ai": "7.0.66",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.31.0",
    "mammoth": "^1.12.1",
    "next": "16.3.1",
    "next-auth": "5.0.0-beta.32",
    "postgres": "3.4.9",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "unpdf": "^1.8.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.4",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitest/coverage-v8": "4.1.10",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.1",
    "eslint-config-prettier": "10.1.8",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "shadcn": "4.16.2",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  }
}
